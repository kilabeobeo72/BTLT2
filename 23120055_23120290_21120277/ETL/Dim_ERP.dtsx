      DTS:ObjectName="Load DimDate (10-2026)"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{430B3F12-54C4-4264-A851-5639802953FA}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.FactSales; TRUNCATE TABLE dbo.ETL_RejectedRows; DELETE FROM dbo.DimCustomer; DBCC CHECKIDENT ('dbo.DimCustomer', RESEED, 0); DELETE FROM dbo.DimProduct; DBCC CHECKIDENT ('dbo.DimProduct', RESEED, 0); DELETE FROM dbo.DimDate; IF NOT EXISTS (SELECT 1 FROM dbo.DimDate WHERE DateKey = 20261001)&#xA;BEGIN&#xA;    DECLARE @d date = '2026-10-01';&#xA;    WHILE @d &lt;= '2026-10-31'&#xA;    BEGIN&#xA;        INSERT INTO dbo.DimDate(DateKey, FullDate, [Month], [Quarter], [Year])&#xA;        VALUES (YEAR(@d)*10000 + MONTH(@d)*100 + DAY(@d), @d, MONTH(@d), DATEPART(quarter, @d), YEAR(@d));&#xA;        SET @d = DATEADD(day, 1, @d);&#xA;    END&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
